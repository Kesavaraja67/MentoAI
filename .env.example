# ── FalkorDB ────────────────────────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# ── Backend ─────────────────────────────────────────────────────────────────
# Allowed origins for CORS (comma-separated). Adjust for production.
CORS_ORIGINS=http://localhost:3000

# ── LLM defaults ────────────────────────────────────────────────────────────
# Set LLM_MODE=fake in tests or demo fallback mode.
LLM_MODE=fake

# Provider: one of groq | openrouter | gemini | openai
LLM_PROVIDER=openai

# Model name — set this yourself after testing which model is available.
LLM_MODEL=gpt-4o-mini

# API key — set this in your real .env, never commit it.
# BYOK: the browser can also supply X-LLM-Key header per request.
LLM_API_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Deploy ──────────────────────────────────────────────────────────────────
# Your domain for Caddy / HTTPS (prod only).
DOMAIN=primer.example.com
